{
  "name": "the-atlas-monorepo",
  "private": true,
  "type": "module",
  "workspaces": [
    "packages/core",
    "packages/cli"
  ],
  "scripts": {
    "build": "npm run build -w the-atlas",
    "typecheck": "tsc -p packages/core && tsc -p packages/cli",
    "test": "vitest run",
    "dev": "tsx packages/cli/src/index.tsx",
    "check:agents": "node scripts/check-agents.mjs"
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "ink-testing-library": "^4.0.0",
    "tsup": "^9.0.0",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vitest": "^5.0.5"
  },
  "engines": {
    "node": ">=22"
  }
}
